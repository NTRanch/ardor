#!/usr/bin/env python3
"""moondeep-sheet — the MoonDeep sheet + delivery kit (TOOLING-PLAN T3).

One builder for the estate's standard sheet deliveries, converging the
four hand-written build_sheets.py variants the 2026-11-27 lanes each
re-derived. Layout constants are the fresh lane's (the layout the
heightfix sheet also used): per-panel caption band on top, DejaVu
Sans-Bold, panel field (18,18,18), sheet field (40,40,40).

USAGE
    moondeep-sheet row  --out NAME [--dir DIR] --panel SPEC [--panel SPEC ...]
    moondeep-sheet cast --out NAME [--dir DIR] --panel SPEC [--panel SPEC ...]
                        [--cols 4] [--scale 2] [--pad 12]

    SPEC = PATH|CLASS|LABEL   (pipe-separated; paths must not contain '|')

    row   Panels side by side at native res (scale 1), 8 px gaps —
          the per-girl two-up / three-up sheet.
    cast  Panels upscaled --scale x inside the sheet and laid out in
          a --cols-wide grid with --pad px padding — the cast sheet.

CAPTION DISCIPLINE (estate Rule 9): every panel MUST carry a class
and a label; the tool refuses an uncaptioned panel (exit 2, nothing
written). The rendered caption is "LABEL - CLASS", or LABEL alone
when the class already appears in it.

OUTPUTS (written into --dir, default "."):
    NAME.png          native-res PNG master sheet
    NAME-4800.jpg     chat JPEG, 4800 px wide, quality 90
                      (Owner sheet-format ruling 2026-11-27 20:08 PT)
    NAME-phone.jpg    phone JPEG, 2600 px wide, quality 90
    NAME.json         only with --sidecar: a sidecar skeleton —
                      per-panel path/sha256/class/label/caption plus
                      base_pin / prompt / seed / grade fields (null,
                      for the lane to fill), and the outputs' sizes.

OPTIONS
    --band N / --font-size N   caption band height / font size in px.
        Defaults derive from scale: band = 30*scale + 24,
        font = 14*scale + 16  (scale 1 -> 54/30, scale 2 -> 84/44,
        the fresh lane's two operating points).
    --gap N    row-mode gap between panels (default 8, at scale 1).
    --sidecar  also write the NAME.json sidecar skeleton.

FAILURE BEHAVIOUR: all panels are validated (existence, caption,
bounds) before anything is built or written; a validation failure
leaves the output directory untouched. An I/O failure mid-write can
leave partial outputs and is reported by name.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import sys
from dataclasses import dataclass
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

MAX_PANELS = 64
MAX_PANEL_PIXELS = 100_000_000
CHAT_JPEG_WIDTH_PX = 4800
PHONE_JPEG_WIDTH_PX = 2600
JPEG_QUALITY = 90
PANEL_FIELD = (18, 18, 18)
SHEET_FIELD = (40, 40, 40)
CAPTION_FILL = (240, 240, 240)
CAPTION_X_PX = 14
CAPTION_Y_PX = 12
ROW_TRAILING_PX = 16  # fresh lane: sheet width = sum(panel widths) + 16
FONT_CANDIDATES = (
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
)


class SheetError(Exception):
    """A caller-fixable problem with the sheet specification."""


@dataclass(frozen=True)
class PanelSpec:
    path: Path
    frame_class: str
    label: str

    @property
    def caption(self) -> str:
        if self.frame_class.lower() in self.label.lower():
            return self.label
        return f"{self.label} - {self.frame_class}"


def parse_panel_spec(raw: str) -> PanelSpec:
    parts = raw.split("|")
    if len(parts) != 3:
        raise SheetError(
            f"panel spec must be PATH|CLASS|LABEL, got {raw!r}")
    path_s, frame_class, label = (p.strip() for p in parts)
    if not path_s:
        raise SheetError(f"panel spec has an empty path: {raw!r}")
    if not frame_class:
        raise SheetError(
            f"panel {path_s!r} has no class — Rule 9 requires every "
            "panel to carry its class caption; refusing to build")
    if not label:
        raise SheetError(
            f"panel {path_s!r} has no label — refusing to build an "
            "uncaptioned panel")
    return PanelSpec(Path(path_s), frame_class, label)


def load_font(size_px: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    for candidate in FONT_CANDIDATES:
        if Path(candidate).exists():
            return ImageFont.truetype(candidate, size_px)
    return ImageFont.load_default()


def load_panel_image(spec: PanelSpec) -> Image.Image:
    if not spec.path.is_file():
        raise SheetError(f"panel image not found: {spec.path}")
    try:
        img = Image.open(spec.path).convert("RGB")
    except Exception as exc:
        raise SheetError(f"panel image unreadable: {spec.path}") from exc
    if img.width * img.height > MAX_PANEL_PIXELS:
        raise SheetError(
            f"panel image exceeds {MAX_PANEL_PIXELS} px: {spec.path}")
    return img


def build_panel(img: Image.Image, caption: str, *, scale: int,
                band_px: int,
                font: ImageFont.FreeTypeFont | ImageFont.ImageFont,
                ) -> Image.Image:
    if scale != 1:
        img = img.resize((img.width * scale, img.height * scale),
                         Image.LANCZOS)
    panel = Image.new("RGB", (img.width, img.height + band_px),
                      PANEL_FIELD)
    panel.paste(img, (0, band_px))
    draw = ImageDraw.Draw(panel)
    draw.text((CAPTION_X_PX, CAPTION_Y_PX), caption,
              fill=CAPTION_FILL, font=font)
    return panel


def assemble_row(panels: list[Image.Image], *, gap_px: int) -> Image.Image:
    height = max(p.height for p in panels)
    content_width = sum(p.width for p in panels) + gap_px * (len(panels) - 1)
    # Fresh-lane semantics: width = sum + 16 (panels flush right for
    # n <= 3 at gap 8); wider rows grow to fit their gaps instead of
    # overflowing.
    width = max(sum(p.width for p in panels) + ROW_TRAILING_PX,
                content_width)
    sheet = Image.new("RGB", (width, height), SHEET_FIELD)
    x_px = 0
    for panel in panels:
        sheet.paste(panel, (x_px, 0))
        x_px += panel.width + gap_px
    return sheet


def assemble_cast(panels: list[Image.Image], *, cols: int,
                  pad_px: int) -> Image.Image:
    cell_w = max(p.width for p in panels)
    cell_h = max(p.height for p in panels)
    rows = math.ceil(len(panels) / cols)
    width = cols * cell_w + (cols + 1) * pad_px
    height = rows * cell_h + (rows + 1) * pad_px
    sheet = Image.new("RGB", (width, height), SHEET_FIELD)
    for idx, panel in enumerate(panels):
        x_px = pad_px + (idx % cols) * (cell_w + pad_px)
        y_px = pad_px + (idx // cols) * (cell_h + pad_px)
        sheet.paste(panel, (x_px, y_px))
    return sheet


def jpeg_derivative(master: Image.Image, target_width_px: int) -> Image.Image:
    # Truncating scale, matching the lanes' delivered derivatives
    # (cast hires 10124x6716 -> 7235 px, not the rounded 7236).
    height = max(1, int(master.height * target_width_px / master.width))
    return master.resize((target_width_px, height), Image.LANCZOS)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def build_sheet(args: argparse.Namespace) -> dict[str, Path]:
    if not args.panel:
        raise SheetError("no panels given — at least one --panel is required")
    if len(args.panel) > MAX_PANELS:
        raise SheetError(f"at most {MAX_PANELS} panels per sheet")
    specs = [parse_panel_spec(raw) for raw in args.panel]
    images = [load_panel_image(spec) for spec in specs]

    scale = args.scale
    if scale < 1:
        raise SheetError("--scale must be >= 1")
    band_px = args.band if args.band is not None else 30 * scale + 24
    font_px = (args.font_size if args.font_size is not None
               else 14 * scale + 16)
    font = load_font(font_px)
    panels = [build_panel(img, spec.caption, scale=scale,
                          band_px=band_px, font=font)
              for img, spec in zip(images, specs)]

    if args.command == "row":
        master = assemble_row(panels, gap_px=args.gap * scale)
    else:
        if args.cols < 1:
            raise SheetError("--cols must be >= 1")
        master = assemble_cast(panels, cols=args.cols, pad_px=args.pad)

    out_dir = Path(args.dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    outputs = {
        "png": out_dir / f"{args.out}.png",
        "jpeg_4800": out_dir / f"{args.out}-4800.jpg",
        "jpeg_phone": out_dir / f"{args.out}-phone.jpg",
    }
    master.save(outputs["png"])
    jpeg_derivative(master, CHAT_JPEG_WIDTH_PX).save(
        outputs["jpeg_4800"], quality=JPEG_QUALITY)
    jpeg_derivative(master, PHONE_JPEG_WIDTH_PX).save(
        outputs["jpeg_phone"], quality=JPEG_QUALITY)

    if args.sidecar:
        sidecar = {
            "sheet": outputs["png"].name,
            "mode": args.command,
            "panels": [
                {"path": str(spec.path), "sha256": sha256_of(spec.path),
                 "class": spec.frame_class, "label": spec.label,
                 "caption": spec.caption, "base_pin": None,
                 "prompt": None, "seed": None, "grade": None}
                for spec in specs
            ],
            "outputs": {
                key: {"path": path.name,
                      "width": Image.open(path).width,
                      "height": Image.open(path).height}
                for key, path in outputs.items()
            },
        }
        sidecar_path = out_dir / f"{args.out}.json"
        sidecar_path.write_text(json.dumps(sidecar, indent=2) + "\n")
        outputs["sidecar"] = sidecar_path
    return outputs


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="moondeep-sheet",
        description="MoonDeep sheet + delivery kit (see file header).")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("row", "cast"):
        sub_parser = sub.add_parser(name)
        sub_parser.add_argument("--out", required=True,
                                help="output basename (no extension)")
        sub_parser.add_argument("--dir", default=".",
                                help="output directory (default: .)")
        sub_parser.add_argument("--panel", action="append", default=[],
                                metavar="PATH|CLASS|LABEL",
                                help="one panel; repeat per panel")
        sub_parser.add_argument("--band", type=int, default=None,
                                help="caption band height px (default: "
                                     "30*scale+24)")
        sub_parser.add_argument("--font-size", type=int, default=None,
                                help="caption font size px (default: "
                                     "14*scale+16)")
        sub_parser.add_argument("--sidecar", action="store_true",
                                help="also write a NAME.json skeleton")
    sub.choices["row"].add_argument(
        "--gap", type=int, default=8, help="gap between panels px "
                                           "(default 8, at scale 1)")
    sub.choices["row"].add_argument(
        "--scale", type=int, default=1, help="panel upscale (default 1)")
    sub.choices["cast"].add_argument(
        "--cols", type=int, default=4, help="grid columns (default 4)")
    sub.choices["cast"].add_argument(
        "--scale", type=int, default=2, help="panel upscale (default 2)")
    sub.choices["cast"].add_argument(
        "--pad", type=int, default=12, help="grid padding px (default 12)")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = make_parser().parse_args(argv)
    try:
        outputs = build_sheet(args)
    except SheetError as exc:
        print(f"moondeep-sheet: error: {exc}", file=sys.stderr)
        return 2
    for key, path in outputs.items():
        img = Image.open(path) if path.suffix in (".png", ".jpg") else None
        dims = f"{img.width}x{img.height}" if img is not None else ""
        print(f"{key}: {path} {dims}".rstrip())
    return 0


if __name__ == "__main__":
    sys.exit(main())
